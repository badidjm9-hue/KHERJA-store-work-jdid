# Example reverse-proxy site. Replace the domain and certificate paths.
# Restrict access to the Node listener so only this proxy can reach it.
server {
    listen 443 ssl http2;
    server_name kherja.example.com;
    ssl_certificate /etc/letsencrypt/live/kherja.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kherja.example.com/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 3m;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, do not append to an untrusted client-supplied X-Forwarded-For.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }
}
server {
    listen 80;
    server_name kherja.example.com;
    return 301 https://$host$request_uri;
}
